# --- Credencials de BonpreuEsclat Online (assistent de compra) ---
ESCLAT_EMAIL=el_teu_email@exemple.com
ESCLAT_PASSWORD=la_teva_contrasenya

# --- Credencials de l'API de MRW (SAGEC) per enviar SMS d'avís ---
# Les proporciona MRW quan et donen d'alta al servei web SAGEC.
MRW_FRANQUICIA=
MRW_ABONAT=
MRW_USUARI=
MRW_CONTRASENYA=
# Departament (opcional, deixa'l buit si no en tens)
MRW_DEPARTAMENT=
# Codi de servei per defecte (opcional): 0005=Econòmic 24h, 0800=Urgent 19...
MRW_CODI_SERVEI=0005
