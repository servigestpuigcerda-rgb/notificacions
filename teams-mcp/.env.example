# Credencials de l'app d'Entra ID (Azure AD) per enviar missatges a Teams.
# Copia aquest fitxer a .env i omple els valors (mira el README.md).

# ID de l'aplicació (Application/client ID) de l'app registrada a Entra ID
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ID del tenant de la teva organització (Directory/tenant ID).
# Pots deixar "organizations" o "common" si no el saps, però el recomanat és el teu tenant.
MS_TENANT_ID=organizations
